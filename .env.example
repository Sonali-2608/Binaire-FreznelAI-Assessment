# Hosted models API (already public, no key needed)
VITE_API_URL=https://binaire.app/hf-models-api.json

# Firebase project config (Project Settings > General > Your apps > SDK setup)
# Enable Email/Password sign-in under Authentication > Sign-in method.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
